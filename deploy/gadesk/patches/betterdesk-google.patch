index 0000000..d7ed245
--- /dev/null
+++ b/betterdesk-server/auth/oidc_google_test.go
@@ -0,0 +1,143 @@
+package auth
+
+import (
+	"context"
+	"crypto"
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/json"
+	"math/big"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"strings"
+	"testing"
+	"time"
+)
+
+type googleFixtureTransport struct{ target string }
+
+func (f googleFixtureTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	if r.URL.String() == "https://www.googleapis.com/oauth2/v3/certs" {
+		r = r.Clone(r.Context())
+		parsed, _ := url.Parse(f.target + "/keys")
+		r.URL = parsed
+	}
+	return http.DefaultTransport.RoundTrip(r)
+}
+
+func TestExchangeGoogleIdentity(t *testing.T) {
+	key, err := rsa.GenerateKey(rand.Reader, 2048)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, test := range []struct {
+		name      string
+		change    string
+		wantError bool
+	}{
+		{"valid stable identity", "", false},
+		{"same email prefix different identity", "other-sub", false},
+		{"wrong signature", "signature", true},
+		{"wrong audience", "aud", true},
+		{"wrong issuer", "iss", true},
+		{"expired token", "exp", true},
+		{"wrong nonce", "nonce", true},
+		{"missing token", "missing", true},
+		{"userinfo identity mismatch", "userinfo-sub", true},
+		{"userinfo unavailable", "userinfo-error", true},
+		{"unverified email", "unverified-email", true},
+	} {
+		t.Run(test.name, func(t *testing.T) {
+			subject := "subject-001"
+			if test.change == "other-sub" {
+				subject = "subject-002"
+			}
+			nonce := ""
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				switch r.URL.Path {
+				case "/keys":
+					_ = json.NewEncoder(w).Encode(map[string]any{"keys": []any{map[string]any{
+						"kty": "RSA", "alg": "RS256", "use": "sig", "kid": "test-key",
+						"n": base64.RawURLEncoding.EncodeToString(key.N.Bytes()),
+						"e": base64.RawURLEncoding.EncodeToString(big.NewInt(int64(key.E)).Bytes()),
+					}}})
+				case "/token":
+					claims := map[string]any{"iss": "https://accounts.google.com", "aud": "gadesk-test-client", "exp": time.Now().Add(time.Hour).Unix(), "iat": time.Now().Unix(), "sub": subject, "nonce": nonce, "email": "same@example.org", "email_verified": true}
+					switch test.change {
+					case "aud":
+						claims["aud"] = "another-client"
+					case "iss":
+						claims["iss"] = "https://attacker.example"
+					case "exp":
+						claims["exp"] = time.Now().Add(-time.Hour).Unix()
+					case "nonce":
+						claims["nonce"] = "another-attempt"
+					case "unverified-email":
+						claims["email_verified"] = false
+					}
+					header, _ := json.Marshal(map[string]string{"alg": "RS256", "kid": "test-key"})
+					body, _ := json.Marshal(claims)
+					unsigned := base64.RawURLEncoding.EncodeToString(header) + "." + base64.RawURLEncoding.EncodeToString(body)
+					digest := sha256.Sum256([]byte(unsigned))
+					sig, err := rsa.SignPKCS1v15(rand.Reader, key, crypto.SHA256, digest[:])
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					if test.change == "signature" {
+						sig[0] ^= 1
+					}
+					token := unsigned + "." + base64.RawURLEncoding.EncodeToString(sig)
+					if test.change == "missing" {
+						token = ""
+					}
+					_ = json.NewEncoder(w).Encode(map[string]string{"access_token": "fixture-access", "id_token": token})
+				case "/userinfo":
+					if test.change == "userinfo-error" {
+						w.WriteHeader(503)
+						return
+					}
+					sub := subject
+					if test.change == "userinfo-sub" {
+						sub = "attacker"
+					}
+					_ = json.NewEncoder(w).Encode(map[string]any{"sub": sub, "email": "same@example.org", "email_verified": test.change != "unverified-email", "name": "Test person"})
+				default:
+					http.NotFound(w, r)
+				}
+			}))
+			defer srv.Close()
+			p := newTestOIDCProvider(t, &OIDCConfig{Enabled: true, ClientID: "gadesk-test-client", IssuerURL: "https://accounts.google.com", AuthorizationURL: "https://accounts.google.com/o/oauth2/v2/auth", TokenURL: srv.URL + "/token", UserinfoURL: srv.URL + "/userinfo", RedirectURL: "https://gadesk.grupoamayo.com/api/oidc/callback", UsePKCE: true, AllowSignup: true, DefaultRole: RolePro})
+			p.client.Transport = googleFixtureTransport{target: srv.URL}
+			authURL, state, err := p.BuildAuthURL("/")
+			if err != nil {
+				t.Fatal(err)
+			}
+			parsed, _ := url.Parse(authURL)
+			nonce = parsed.Query().Get("nonce")
+			result, err := p.ExchangeCode(context.Background(), "fixture-code", state)
+			if test.wantError {
+				if err == nil {
+					t.Fatalf("invalid Google identity accepted: %+v", result)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatal(err)
+			}
+			if result.Username != "google:"+subject || result.Role != RolePro {
+				t.Fatalf("identity/role = %q/%q, want google:%s/pro", result.Username, result.Role, subject)
+			}
+			if _, err := p.ExchangeCode(context.Background(), "fixture-code", state); err == nil {
+				t.Fatal("replayed state accepted")
+			}
+			if strings.Contains(result.Username, "same") {
+				t.Fatal("email used as account identity")
+			}
+		})
+	}
+}
