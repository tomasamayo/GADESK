diff --git a/betterdesk-server/auth/oidc_google.go b/betterdesk-server/auth/oidc_google.go
new file mode 100644
index 0000000..47ad487
--- /dev/null
+++ b/betterdesk-server/auth/oidc_google.go
@@ -0,0 +1,47 @@
+package auth
+
+import (
+	"context"
+	"crypto/subtle"
+	"fmt"
+	"strings"
+
+	"github.com/coreos/go-oidc/v3/oidc"
+)
+
+func IsGoogleIssuer(issuer string) bool {
+	return strings.TrimRight(issuer, "/") == "https://accounts.google.com"
+}
+
+func (p *OIDCProvider) verifyGoogleIdentity(ctx context.Context, cfg OIDCConfig, rawIDToken, nonce string, userinfo map[string]interface{}) (map[string]interface{}, error) {
+	if rawIDToken == "" || nonce == "" {
+		return nil, fmt.Errorf("Google identity or login nonce missing")
+	}
+	ctx = oidc.ClientContext(ctx, p.client)
+	keys := oidc.NewRemoteKeySet(ctx, "https://www.googleapis.com/oauth2/v3/certs")
+	verifier := oidc.NewVerifier("https://accounts.google.com", keys, &oidc.Config{
+		ClientID: cfg.ClientID, SupportedSigningAlgs: []string{"RS256"},
+	})
+	token, err := verifier.Verify(ctx, rawIDToken)
+	if err != nil {
+		return nil, fmt.Errorf("Google identity validation failed")
+	}
+	if token.Subject == "" || subtle.ConstantTimeCompare([]byte(token.Nonce), []byte(nonce)) != 1 {
+		return nil, fmt.Errorf("Google identity does not match this login")
+	}
+	claims := make(map[string]interface{})
+	if err := token.Claims(&claims); err != nil {
+		return nil, fmt.Errorf("Google identity claims invalid")
+	}
+	if claims["email_verified"] != true || getStringClaim(userinfo, "sub") != token.Subject || userinfo["email_verified"] != true {
+		return nil, fmt.Errorf("Google profile identity not verified")
+	}
+	// Only use display attributes after binding UserInfo to the verified subject.
+	for _, name := range []string{"name", "picture", "email"} {
+		if value, ok := userinfo[name].(string); ok {
+			claims[name] = value
+		}
+	}
+	claims["gadesk_username"] = "google:" + token.Subject
+	return claims, nil
+}
diff --git a/betterdesk-server/auth/oidc_google_test.go b/betterdesk-server/auth/oidc_google_test.go
