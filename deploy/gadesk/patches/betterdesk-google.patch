+func TestGoogleSignupRejectsExistingLocalAccount(t *testing.T) {
+	database := testSetupDB(t)
+	defer database.Close()
+	hash, err := auth.HashPassword("unused")
+	if err != nil {
+		t.Fatal(err)
+	}
+	user := &db.User{Username: "google:subject-001", PasswordHash: hash, Role: auth.RoleAdmin, AuthProvider: db.AuthProviderLocal}
+	if err := database.CreateUser(user); err != nil {
+		t.Fatal(err)
+	}
+	s := &Server{db: database}
+	got, code := s.ensureOIDCUser(&auth.OIDCResult{Username: user.Username, Role: auth.RolePro}, &auth.OIDCConfig{IssuerURL: "https://accounts.google.com", AllowSignup: true, DefaultRole: auth.RolePro})
+	if got != nil || code == "" {
+		t.Fatal("Google signup claimed an existing local administrator")
+	}
+	stored, err := database.GetUser(user.Username)
+	if err != nil || stored.AuthProvider != db.AuthProviderLocal {
+		t.Fatal("local account was modified")
+	}
+}
+
+func TestGoogleAccountsKeepPrivateBooksAndNoInventory(t *testing.T) {
+	database := testSetupDB(t)
+	defer database.Close()
+	s := newClientLoginTestServer(database)
+	cfg := &auth.OIDCConfig{IssuerURL: "https://accounts.google.com", AllowSignup: true, DefaultRole: auth.RolePro}
+	for _, subject := range []string{"subject-001", "subject-002"} {
+		username := "google:" + subject
+		user, code := s.ensureOIDCUser(&auth.OIDCResult{Username: username, Role: auth.RolePro}, cfg)
+		if code != "" || user.Role != auth.RolePro {
+			t.Fatalf("signup failed: %q", code)
+		}
+		body := `{"data":{"peers":[{"id":"` + subject + `"}],"tags":[]}}`
+		req := withClientUser(httptest.NewRequest(http.MethodPost, "/api/ab/personal", strings.NewReader(body)), username, auth.RolePro)
+		rec := httptest.NewRecorder()
+		s.handleClientAddressBookPersonal(rec, req)
+		if rec.Code != 200 {
+			t.Fatalf("save failed: %d", rec.Code)
+		}
+	}
+	for _, subject := range []string{"subject-001", "subject-002"} {
+		req := withClientUser(httptest.NewRequest(http.MethodGet, "/api/ab/personal", nil), "google:"+subject, auth.RolePro)
+		rec := httptest.NewRecorder()
+		s.handleClientAddressBookPersonal(rec, req)
+		other := "subject-001"
+		if subject == other {
+			other = "subject-002"
+		}
+		if rec.Code != 200 || !strings.Contains(rec.Body.String(), subject) || strings.Contains(rec.Body.String(), other) {
+			t.Fatalf("personal data isolation failed: %s", rec.Body.String())
+		}
+		peers, total := s.buildRustDeskPeerList(req)
+		if total != 0 || len(peers) != 0 {
+			t.Fatal("public account received server device inventory")
+		}
+		denied := httptest.NewRecorder()
+		s.requirePermission(auth.PermServerConfig, func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(200) })(denied, req)
+		if denied.Code != http.StatusForbidden {
+			t.Fatal("public account received admin permission")
+		}
+	}
+}
